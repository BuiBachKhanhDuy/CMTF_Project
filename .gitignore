# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Pytest
.pytest_cache/

# Caches (regenerated at runtime) — but KEEP the offline-demo bundle tracked so a
# fresh clone can run the real-time multi-agent chatbot (chat.py) without a rebuild.
cache/*
!cache/predictions/
!cache/deploy_models/
!cache/news/
!cache/dataset/
# deploy_models: keep checkpoints + meta, drop local backup snapshots
cache/deploy_models/backup*/
# dataset: keep ONLY the 6 current-champion parquets (1D/5D/20D × standard+livewide)
cache/dataset/*
!cache/dataset/dataset_b82d8f58c2ef2a25.parquet
!cache/dataset/dataset_b82d8f58c2ef2a25_livewide.parquet
!cache/dataset/dataset_a1d2615cb5b052be.parquet
!cache/dataset/dataset_a1d2615cb5b052be_livewide.parquet
!cache/dataset/dataset_4aa2ece45a8d1fe9.parquet
!cache/dataset/dataset_4aa2ece45a8d1fe9_livewide.parquet

# Artifacts (regenerated by pipeline)
artifacts/

# Local full-project archive (≈10 GB — far too large for git; rebuild locally)
*.zip

# Kaggle bundle folder (large, only keep the .zip)
kaggle_bundle/

# Model outputs (large checkpoints, not for VCS)
outputs/sentiment/_rerun_both

# External data / binaries (downloaded at setup time)
data/external/

# OS files
Thumbs.db
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Diagnostic / scratch scripts (not part of main pipeline)
diag_cmtf.py

docs/
